# LLM / VLM Provider：mock（默认，离线可跑）| openai（OpenAI 兼容协议）
FQA_LLM_PROVIDER=mock
FQA_LLM_API_KEY=
FQA_LLM_MODEL=gpt-4o-mini
FQA_LLM_BASE_URL=https://api.openai.com/v1

# 条款映射阈值（默认值来自 scripts/run_eval.py 网格搜索）
FQA_MAP_HIGH_TH=0.70
FQA_MAP_MID_TH=0.45
FQA_MAP_RECALL_K=10
FQA_MAP_RERANK_N=5
FQA_MAP_RRF_K=60
FQA_MAP_MIN_CANDIDATES=20

# 证据验证阈值
FQA_EV_IMG_REJECT=0.95
FQA_EV_IMG_UNC_LO=0.85
FQA_EV_DOC_REJECT=0.90
FQA_EV_VLM_PASS=0.80
FQA_EV_REJECT_ESC=2
FQA_EV_REJECT_NOTIFY=3

# 分级
FQA_GRADE_LLM_CONF=0.70

# 时钟与抽验
FQA_HUMAN_TASK_TIMEOUT=24
FQA_RECUR_WINDOW=30

# 存储
FQA_DATA_DIR=./data
FQA_DB_PATH=./data/fqa.db
